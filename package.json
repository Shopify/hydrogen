{
  "name": "hydrogen-preview-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:pkgs": "turbo run build --filter='./packages/*'",
    "dev": "turbo run dev",
    "dev:pkgs": "turbo run dev --filter='./packages/*'",
    "dev:rr": "turbo run dev --filter=@shopify/hydrogen-example-react-router...",
    "dev:next": "turbo run dev --filter=@shopify/hydrogen-example-nextjs...",
    "dev:astro": "turbo run dev --filter=@shopify/hydrogen-example-astro...",
    "dev:nuxt": "turbo run dev --filter=@shopify/hydrogen-example-nuxt...",
    "dev:nuxt-binding": "turbo run dev --filter=@shopify/hydrogen-example-nuxt-binding...",
    "dev:solid": "turbo run dev --filter=@shopify/hydrogen-example-solid-start...",
    "dev:svelte": "turbo run dev --filter=@shopify/hydrogen-example-sveltekit...",
    "dev:hydrogen": "pnpm --dir examples/hydrogen dev",
    "dev:hub": "node scripts/examples-dev.ts",
    "https:setup": "mkcert -install && mkdir -p .cert && mkcert -cert-file .cert/localtest.me.pem -key-file .cert/localtest.me-key.pem localtest.me",
    "download:standard-types": "node scripts/download-standard-types.ts",
    "sync:template-skills": "node scripts/sync-template-skills.ts",
    "sync:template-skills:check": "node scripts/sync-template-skills.ts --check",
    "examples:secrets:setup": "node scripts/setup-example-secrets-key.ts",
    "examples:secrets:encrypt": "ejson encrypt examples/shared/secrets.ejson",
    "examples:secrets:decrypt": "node scripts/decrypt-example-secrets.ts",
    "benchmark:harness": "node scripts/storefront-benchmark-harness/run-opencode-docker.ts",
    "typecheck": "turbo run typecheck",
    "libcheck": "turbo run libcheck --filter='./packages/*'",
    "lint": "oxlint --max-warnings=0 packages/ examples/ scripts/sync-template-skills*.ts",
    "lint:ci": "oxlint --format github --max-warnings=0 packages/ examples/ scripts/sync-template-skills*.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test": "pnpm run test:scripts && turbo run test",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:benchmark-harness": "tsc -p scripts/storefront-benchmark-harness/tsconfig.json && node --test scripts/storefront-benchmark-harness/*.test.ts",
    "check": "pnpm run sync:template-skills:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "test:e2e:storefront": "turbo run test:e2e --filter @shopify/storefront-e2e"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@changesets/cli": "3.0.0-next.8",
    "@changesets/parse": "1.0.0-next.7",
    "@types/node": "^25.8.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "turbo": "^2.9.14",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@shopify/hydrogen": "workspace:*"
    },
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
