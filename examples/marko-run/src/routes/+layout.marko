import "../app.css";
import { initializeShopifyScripts } from "@shopify/hydrogen";
import { AnalyticsEvent, addAnalyticsConsoleDestination, getAnalytics } from "../lib/analytics";
import { routeTemplates } from "../lib/route-templates";
server import { analyticsConsent, defaultI18n, shop } from "@shared/config";
server import { renderShopifyScriptTags } from "@shopify/hydrogen";

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    $!{renderShopifyScriptTags({ consent: analyticsConsent, i18n: defaultI18n, shop }).join("")}
    <title>${$global.data.pageTitle || "Mock.shop — Hydrogen"}</title>
  </head>
  <body>
    <div class="bg-white text-black">
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-black focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white"
      >
        Skip to main content
      </a>
      <site-header />
      <${input.content}/>
      <site-footer />
      <cart-drawer />
      <script>
        void initializeShopifyScripts({ routes: routeTemplates });
        addAnalyticsConsoleDestination();
        getAnalytics()?.publish(AnalyticsEvent.PAGE_VIEWED);
      </script>
    </div>
  </body>
</html>
