# Server environment. Copy to `.env`; the scripts load it with `node --env-file-if-exists=.env`.

# Local development only. `start` requires a private, generated secret.
SESSION_SECRET="local-dev-session-secret-32-characters"
PUBLIC_STORE_DOMAIN="hydrogen-preview.myshopify.com"
# Optional. Run `pnpm run examples:secrets:decrypt` from the repo root to fill it in.
# Without it, the example uses the public token below instead of buyer-aware SSR.
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_API_TOKEN="b97a750a8afa8fe33f2b4012cb3a9f6f"
# Customer Account API (`/account`). OAuth needs HTTPS: `pnpm dev:https`.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID="shp_e2b55f4e-9dd6-48aa-91f8-5fa419fda119"
SHOP_ID="55145660472"
