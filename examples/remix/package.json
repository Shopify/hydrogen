    "test": "NODE_ENV=test remix test"
  },
  "dependencies": {
    "@pitlane/assets": "0.2.0",
    "@shopify/hydrogen": "workspace:*",
    "remix": "3.1.0"
  },
  "devDependencies": {
    "@pitlane/vite-plugin-remix": "0.9.0",
    "@shopify/cli": "4.8.1",
    "@shopify/mini-oxygen": "workspace:*",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@types/node": "^25.8.0",
    "typescript": "catalog:",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
