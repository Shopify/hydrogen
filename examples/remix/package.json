{
  "name": "@shopify/hydrogen-example-remix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "dev:https": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "shopify hydrogen deploy --build-command 'pnpm build'",
