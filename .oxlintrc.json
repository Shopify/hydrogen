{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.svelte-kit/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.astro/**",
    "**/.vinxi/**",
    "**/.react-router/**",
    "**/node_modules/**",
    "patches/**",
    "scripts/**",
    "!scripts/copy-hydrogen-to-preview*.ts",
    "!scripts/preview-template-dist*.ts",
    "!scripts/test-local-https.ts",
    "examples/**",
    "!examples/shared/local-cdn-assets-plugin/**/*.ts",
    "examples/hydrogen/**",
    "!examples/hydrogen/app/components/PaginatedResourceSection.tsx",
    "!examples/hydrogen/app/lib/pagination.ts",
    "!examples/hydrogen/e2e/fixtures/index.ts",
    "!examples/hydrogen/e2e/fixtures/test-secrets.ts",
    "!examples/hydrogen/hydrate-e2e-env-secrets.ts",
    "**/vendor/**",
    "**/public/*",
    "**/static/*",
    "**/*.d.ts"
  ],
  "rules": {
    "complexity": ["error", 12],
    "max-depth": ["error", 3],
    // Deliberately omit max-lines: we want cognitive-complexity guardrails
    // without incentivising arbitrary file splitting.
    "no-unused-vars": "warn",
    "import/no-cycle": "off",
    "unicorn/no-null": "off",
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": "off",
    "import/no-unassigned-import": "off",
    "@typescript-eslint/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "@typescript-eslint/consistent-type-imports": "error",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unsafe-assignment": "error",
    "@typescript-eslint/no-unsafe-call": "error",
    "@typescript-eslint/no-unsafe-member-access": "error",
    "@typescript-eslint/no-unsafe-return": "error",
    "@typescript-eslint/no-non-null-assertion": "error",
    "@typescript-eslint/prefer-nullish-coalescing": "error",
    "@typescript-eslint/promise-function-async": "error",
    "@typescript-eslint/strict-boolean-expressions": "error",
    "@typescript-eslint/switch-exhaustiveness-check": "error",
    "unicorn/no-array-reverse": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.type-test.ts", "**/e2e/**"],
      "rules": {
        "complexity": "off",
        "max-depth": "off",
        "@typescript-eslint/consistent-type-assertions": "off",
        "@typescript-eslint/consistent-type-imports": "off",
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "packages/hydrogen/src/graphql/graphql.ts",
        "packages/hydrogen/src/graphql/type-resolver.ts",
        "packages/hydrogen/src/client/types.ts"
      ],
      "rules": {
        "@typescript-eslint/consistent-type-assertions": "off",
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "examples/nuxt/components/CartDiscountCodes.vue",
        "examples/nuxt/nuxt.config.ts",
        "examples/nuxt/pages/blogs/news/*.vue",
        "examples/nuxt/pages/index.vue",
        "examples/nuxt/pages/products/*.vue",
        "templates/react-router/app/components/AnalyticsTrackers.tsx",
        "templates/react-router/app/components/ConsentBanner.tsx",
        "templates/react-router/app/lib/analytics.ts",
        "templates/react-router/app/lib/collection.ts",
        "templates/react-router/app/lib/money.ts",
        "templates/react-router/app/lib/search.ts",
        "templates/react-router/server.ts",
        "templates/nextjs/lib/filters.tsx",
        "templates/nextjs/app/collections/**/page.tsx",
        "templates/nextjs/app/search/page.tsx",
        "examples/shared/private-env.ts",
        "packages/hydrogen/src/cli/setup.ts",
        "packages/hydrogen/src/core/analytics/bus.ts",
        "packages/hydrogen/src/core/analytics/cdn/utils/browser-params.ts",
        "packages/hydrogen/src/core/analytics/cdn/utils/monorail.ts",
        "packages/hydrogen/src/core/analytics/destination-manager.ts",
        "packages/hydrogen/src/core/analytics/events.ts",
        "packages/hydrogen/src/core/cart/attach-quantity-input.ts",
        "packages/hydrogen/src/core/cart/form.ts",
        "packages/hydrogen/src/core/cart/get-cart.ts",
        "packages/hydrogen/src/core/cart/server-handlers.ts",
        "packages/hydrogen/src/core/predictive-search/server-handlers.ts",
        "packages/hydrogen/src/core/predictive-search/store.ts",
        "packages/hydrogen/src/core/cart/standard-actions-adapter.ts",
        "packages/hydrogen/src/core/cart/cart.ts",
        "packages/hydrogen/src/core/cart/state.ts",
        "packages/hydrogen/src/core/collection/collection.ts",
        "packages/hydrogen/src/core/request-routing/interceptors/graphiql.ts",
        "packages/hydrogen/src/core/money/format.ts",
        "packages/hydrogen/src/core/observable.ts",
        "packages/hydrogen/src/core/product/product-form.ts",
        "packages/hydrogen/src/react/cart.tsx",
        "packages/hydrogen/src/react/collection.tsx",
        "packages/hydrogen/src/react/predictive-search.tsx",
        "packages/hydrogen/src/vue/cart.ts",
        "packages/hydrogen/src/vue/collection.ts",
        "packages/hydrogen/src/vue/predictive-search.ts",
        "packages/hydrogen/src/vue/product.ts"
      ],
      "rules": {
        "@typescript-eslint/consistent-type-assertions": "off"
      }
    },
    {
      "files": [
        "examples/nuxt/components/CollectionBrowserContent.vue",
        "examples/nuxt/error.vue",
        "examples/nuxt/pages/collections/*.vue",
        "templates/react-router/app/components/CartDrawer.tsx",
        "templates/react-router/app/components/CollectionBrowse.tsx",
        "templates/react-router/app/components/CollectionCard.tsx",
        "templates/react-router/app/components/ProductCard.tsx",
        "templates/react-router/app/routes/collection.tsx",
        "templates/react-router/app/routes/product.tsx",
        "templates/react-router/app/routes/search.tsx",
        "templates/nextjs/components/CollectionBrowser.tsx",
        "templates/nextjs/components/ProductDetails.tsx",
        "templates/nextjs/components/ProductCard.tsx",
        "templates/nextjs/components/CartLineItem.tsx",
        "templates/nextjs/app/search/page.tsx",
        "packages/hydrogen/src/client/client.ts",
        "packages/hydrogen/src/core/analytics/cart-tracker.ts",
        "packages/hydrogen/src/core/analytics/cdn/shopify-analytics.ts",
        "packages/hydrogen/src/core/shopify-scripts/consent.ts",
        "packages/hydrogen/src/core/shopify-scripts/utils/tracking-values.ts",
        "packages/hydrogen/src/core/cart/actions.ts",
        "packages/hydrogen/src/core/cart/queries.ts",
        "packages/hydrogen/src/core/predictive-search/queries.ts",
        "packages/hydrogen/src/core/predictive-search/search.ts",
        "packages/hydrogen/src/core/collection/reconciler.ts",
        "packages/hydrogen/src/core/collection/url.ts",
        "packages/hydrogen/src/core/request-context.ts",
        "packages/hydrogen/src/core/product/form.ts"
      ],
      "rules": {
        "complexity": "off",
        "max-depth": "off",
        "@typescript-eslint/consistent-type-assertions": "off"
      }
    },
    {
      "files": [
        "templates/nextjs/components/ProductViewedTracker.tsx",
        "templates/nextjs/components/CartViewedTracker.tsx",
        "templates/react-router/app/components/AnalyticsTrackers.tsx"
      ],
      "rules": {
        // Analytics view trackers intentionally key their effect on route
        // identity (product handle / cart id), not every field they read, so a
        // cart-store update on a PDP doesn't re-publish PRODUCT_VIEWED etc.
        // (hydrogen-analytics/references/react.md). The skill pattern
        // under-depends by design.
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      "files": ["templates/react-router/app/routes/*.tsx"],
      "rules": {
        "no-empty-pattern": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": ["*.type-test.ts"],
      "rules": {
        "no-unused-expressions": "off"
      }
    },
    {
      "files": ["packages/hydrogen/src/**"],
      "rules": {
        "no-console": "error"
      }
    },
    {
      "files": ["packages/hydrogen/src/cli/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.*"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
