# Copy to .env.local (gitignored) and fill in.
# Storefront under test and its shop (tokenless Storefront API discovery).
STOREFRONT_BASE_URL=http://localhost:4201/
STOREFRONT_SHOP_DOMAIN=
# Model endpoint for the agent. Any endpoint that speaks the provider's API.
STOREFRONT_AGENT_MODEL=anthropic/
STOREFRONT_AGENT_MODEL_URL=
STOREFRONT_AGENT_MODEL_TOKEN=
