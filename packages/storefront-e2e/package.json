{
  "name": "@shopify/storefront-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "test": "pnpm run test:unit",
    "typecheck": "tsc --noEmit",
    "cli": "node src/cli.ts",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --dir src --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --dir src .integration.test.ts"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "3.7.3",
    "@shopify/hydrogen": "workspace:*",
    "playwright-core": "1.59.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.8.0",
    "typescript": "catalog:",
    "vitest": "^3.0.0"
  }
}
