# Worker environment. Copy this file to `.env` for local real-store development.
# With no private Storefront API token, the template runs against mock.shop.

# Force mock.shop even when real-store variables are present.
# MOCK_SHOP=1

# Real store. Set all three together. A linked Oxygen storefront injects them.
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_ID=
PRIVATE_STOREFRONT_API_TOKEN=

# Optional Customer Accounts. Set all three together for real-store mode.
# SHOP_ID must contain only digits. Generate a 32+ character session secret.
SHOP_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
CUSTOMER_ACCOUNT_SESSION_SECRET=
