# Worker environment. Copy to `.env` and fill in values for a real store.
# With no private Storefront API token, the template runs against mock.shop.

# Force the tokenless mock.shop demo.
# MOCK_SHOP=1

# Real store. Oxygen injects PUBLIC_STORE_DOMAIN and PRIVATE_STOREFRONT_API_TOKEN
# for a linked storefront; set them locally when not using mock.shop.
PUBLIC_STORE_DOMAIN=
PRIVATE_STOREFRONT_API_TOKEN=

# SEO canonical URL for sitemap, robots, and meta tags.
PUBLIC_SITE_ORIGIN=

# Shopify Scripts identity. Replace these when pointing at your own store.
SHOP_ID=
PUBLIC_STOREFRONT_ID=

# Optional Customer Accounts. The account route stays disabled until all three
# values are set and the app is running against a real store.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
CUSTOMER_ACCOUNT_SESSION_SECRET=
